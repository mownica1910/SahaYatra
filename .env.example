# ============================================================
# SahaYatra - Environment Variables
# ============================================================
# This file contains variable names and example values only.
# NEVER put real API keys, passwords, or secrets in this file.
#
# For local development:
# 1. Copy this file to .env
# 2. Replace placeholder values with your actual credentials
# 3. Never commit .env to GitHub
# ============================================================


# -------------------------
# Application
# -------------------------

APP_NAME=SahaYatra
APP_ENV=development
DEBUG=true

# Backend server
HOST=127.0.0.1
PORT=8000

# Frontend URL
FRONTEND_URL=http://localhost:5173


# -------------------------
# MongoDB
# -------------------------

# Local MongoDB example:
MONGODB_URI=mongodb://localhost:27017

# Database name
MONGODB_DATABASE=sahayatra


# -------------------------
# AI / LLM
# -------------------------

# LLM provider name
LLM_PROVIDER=your_provider

# API key for the selected LLM provider
LLM_API_KEY=your_llm_api_key_here

# Model used by Planner and Recovery Agents
LLM_MODEL=your_model_name


# -------------------------
# Email Notifications
# -------------------------

# Email provider
EMAIL_PROVIDER=your_email_provider

# Sender email address
EMAIL_FROM=your_sender_email@example.com

# Email service API key
EMAIL_API_KEY=your_email_api_key_here


# -------------------------
# AeroSync
# -------------------------

# Enable / disable AeroSync
AEROSYNC_ENABLED=true

# Demo / mock disruption mode
AEROSYNC_DEMO_MODE=true

# How frequently AeroSync checks for events
AEROSYNC_CHECK_INTERVAL_SECONDS=60


# -------------------------
# Security
# -------------------------

# Generate a strong random value for actual development
SECRET_KEY=your_secret_key_here

# JWT configuration if authentication uses JWT
JWT_SECRET_KEY=your_jwt_secret_key_here

JWT_ALGORITHM=HS256

JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60


# -------------------------
# CORS
# -------------------------

# Frontend origins allowed to access the backend
CORS_ORIGINS=http://localhost:5173


# -------------------------
# Application Timezone
# -------------------------

# Store timestamps in UTC
TIMEZONE=UTC


# ============================================================
# IMPORTANT SECURITY RULES
# ============================================================
#
# NEVER commit the following to GitHub:
#
# - .env
# - MongoDB passwords
# - LLM API keys
# - Email API keys
# - JWT secrets
# - Private keys
# - Service-account credentials
#
# .env.example is safe to commit because it contains only
# variable names and placeholder values.
#
# Actual credentials must be stored only in your local .env
# file or in the appropriate deployment secret manager.
# ============================================================
